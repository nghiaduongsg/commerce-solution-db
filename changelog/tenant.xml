<databaseChangeLog logicalFilePath="commerce/tenant" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">
  <!-- Stable logical paths keep identities independent of checkout/container location. -->
  <changeSet id="tenant-legacy-state-guard" author="commerce" runAlways="true">
    <sql splitStatements="false"><![CDATA[
DO $guard$
DECLARE state record;
BEGIN
  IF to_regclass('public.schema_migrations_tenant') IS NOT NULL THEN
    EXECUTE 'SELECT version, dirty FROM public.schema_migrations_tenant' INTO state;
    IF state.version IS NULL OR state.dirty IS DISTINCT FROM false OR state.version < 1 OR state.version > 9
       OR (SELECT count(*) FROM public.schema_migrations_tenant) <> 1 THEN
      RAISE EXCEPTION 'Unsafe legacy tenant migration state. Repair the old migration state before adopting Liquibase.';
    END IF;
  END IF;
END
$guard$;
    ]]></sql>
    <rollback/>
  </changeSet>
  <changeSet id="0001_messaging" author="commerce" logicalFilePath="commerce/tenant">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><and>
        <tableExists schemaName="public" tableName="schema_migrations_tenant"/>
        <sqlCheck expectedResult="1">SELECT CASE WHEN version &gt;= 1 AND NOT dirty THEN 1 ELSE 0 END FROM public.schema_migrations_tenant</sqlCheck>
      </and></not>
    </preConditions>
    <sqlFile path="../db/migrations/tenant/0001_messaging.up.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
    <rollback>
      <sqlFile path="../db/migrations/tenant/0001_messaging.down.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
    </rollback>
  </changeSet>
