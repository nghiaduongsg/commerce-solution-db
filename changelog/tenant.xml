  <changeSet id="tenant-archive-legacy-state" author="commerce">
    <sql splitStatements="false"><![CDATA[
DO $archive$
BEGIN
  IF to_regclass('public.schema_migrations_tenant') IS NOT NULL THEN
    ALTER TABLE public.schema_migrations_tenant RENAME TO legacy_schema_migrations_tenant;
  END IF;
END
$archive$;
    ]]></sql>
    <!-- Keep the old version record for audit. Never reactivate the old runner. -->
