<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog logicalFilePath="commerce/controlplane" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">
  <!-- Stable logical paths keep identities independent of checkout/container location. -->
  <changeSet id="controlplane-legacy-state-guard" author="commerce" runAlways="true">
    <sql splitStatements="false"><![CDATA[
DO $guard$
DECLARE state record;
BEGIN
  IF to_regclass('public.schema_migrations_controlplane') IS NOT NULL THEN
    EXECUTE 'SELECT version, dirty FROM public.schema_migrations_controlplane' INTO state;
    IF state.version IS NULL OR state.dirty IS DISTINCT FROM false OR state.version < 1 OR state.version > 5
       OR (SELECT count(*) FROM public.schema_migrations_controlplane) <> 1 THEN
      RAISE EXCEPTION 'Unsafe legacy controlplane migration state. Repair the old migration state before adopting Liquibase.';
    END IF;
  END IF;
END
$guard$;
    ]]></sql>
    <rollback/>
  </changeSet>
  <changeSet id="0001_identity" author="commerce" logicalFilePath="commerce/controlplane">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not><and>
        <tableExists schemaName="public" tableName="schema_migrations_controlplane"/>
        <sqlCheck expectedResult="1">SELECT CASE WHEN version &gt;= 1 AND NOT dirty THEN 1 ELSE 0 END FROM public.schema_migrations_controlplane</sqlCheck>
      </and></not>
    </preConditions>
    <sqlFile path="../db/migrations/controlplane/0001_identity.up.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
    <rollback>
      <sqlFile path="../db/migrations/controlplane/0001_identity.down.sql" relativeToChangelogFile="true" splitStatements="false" stripComments="false"/>
    </rollback>
  </changeSet>
