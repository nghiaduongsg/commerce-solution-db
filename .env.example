# Copy to .env. The owner is only used by the migration job.
LIQUIBASE_COMMAND_URL=jdbc:postgresql://host.docker.internal:5433/commerce
LIQUIBASE_COMMAND_USERNAME=commerce
LIQUIBASE_COMMAND_PASSWORD=commerce
# primary.xml: tenant + control plane. tenant.xml: premium database only.
LIQUIBASE_COMMAND_CHANGELOG_FILE=changelog/primary.xml
